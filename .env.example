# Copie este arquivo para .env e preencha antes de subir com docker compose.
# NUNCA suba o .env de verdade pro Git - ele ja esta no .gitignore.

# Obrigatoria em qualquer deploy publico. Sem ela, QUALQUER PESSOA na internet
# usa a CPU do seu servidor pra transcrever video e baixar do YouTube pela sua conta.
AUTH_SENHA=troque-isso-por-uma-senha-forte

# Quantas threads a transcricao usa. Ajuste ao numero de vCPU do seu plano
# (deixe 1 ou 2 a menos que o total, pro servidor nao travar).
NUM_THREADS=2

# maxima | alta | rapida - "maxima" pode levar mais de uma hora de encode
# numa CPU compartilhada. "alta" e o equilibrio recomendado em servidor.
QUALIDADE_PADRAO=alta

# Tamanho maximo de um upload/download de video, em MB.
LIMITE_UPLOAD_MB=8192

# small (padrao, ~464 MB) | medium (~1,5 GB, melhor qualidade, mais lento)
# Isso so tem efeito no BUILD da imagem (docker compose build --build-arg),
# nao muda em runtime.
MODELO_WHISPER=small

# Porta exposta no seu computador/servidor (fora do container).
PORTA_EXTERNA=8080
